@model IReadOnlyCollection<WebDispositivosMqtt.Controllers.DeviceAdminViewModel>

@{
    ViewData["Title"] = "Administración de dispositivos";
}

@functions {
    private static string? AsUtcIso(DateTime? value)
    {
        if (value is null) return null;
        var utc = value.Value.Kind switch
        {
            DateTimeKind.Utc   => value.Value,
            DateTimeKind.Local => value.Value.ToUniversalTime(),
            _                  => DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)
        };
        return utc.ToString("O");
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Administración de dispositivos</h2>
</div>

@if (TempData["Ok"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>MAC</th>
            <th>Habilitado</th>
            <th>Registrado por</th>
            <th>Fecha registro</th>
            <th>Password</th>
            <th>DynSec</th>
            <th>Entregado</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No hay dispositivos registrados.</td>
            </tr>
        }
        else
        {
            foreach (var d in Model)
            {
                <tr>
                    <td>@d.Name</td>
                    <td><code>@d.MacAddress</code></td>
                    <td>@(d.IsEnabled ? "Sí" : "No")</td>
                    <td>@d.RegisteredByUserName</td>
                    <td data-utc-datetime="@(AsUtcIso(d.RegisteredAtUtc) ?? "")"></td>
                    <td>
                        @if (d.HasPassword)
                        {
                            <span class="badge bg-success">ok</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">---</span>
                        }
                        <form method="post"
                              asp-controller="Devices"
                              asp-action="SetPassword"
                              class="d-inline ms-1"
                              onsubmit="return confirm('@(d.HasPassword ? $"¿Recrear password para {d.Name}? La contraseña actual quedará inválida." : $"¿Crear password para {d.Name}?")')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="deviceId" value="@d.DeviceId" />
                            <button type="submit" class="btn btn-sm @(d.HasPassword ? "btn-outline-warning" : "btn-outline-primary")">
                                @(d.HasPassword ? "Recrear" : "Crear")
                            </button>
                        </form>
                    </td>
                    <td>
                        <span class="badge bg-secondary dynsec-badge" data-mac="@d.MacAddress">—</span>
                        <button class="btn btn-sm btn-outline-secondary btn-verify-dynsec ms-1"
                                data-mac="@d.MacAddress" title="Verificar DynSec">
                            <small>Verificar</small>
                        </button>
                    </td>
                    <td>
                        @if (d.IsDelivered)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                        @if (d.HasPassword)
                        {
                            <form method="post"
                                  asp-controller="Devices"
                                  asp-action="OpenWindow"
                                  class="d-inline ms-1"
                                  onsubmit="return confirm('¿Abrir ventana de provisioning para @d.Name?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="deviceId" value="@d.DeviceId" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    Abrir ventana
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // Verificación DynSec por dispositivo
        async function applyDynsecStatus(badge, data) {
            switch (data.status) {
                case "Enabled":
                    badge.className = "badge bg-success dynsec-badge";
                    badge.textContent = "Habilitado";
                    badge.title = data.roles?.join(", ") ?? "";
                    break;
                case "Disabled":
                    badge.className = "badge bg-warning text-dark dynsec-badge";
                    badge.textContent = "Deshabilitado";
                    badge.title = data.roles?.join(", ") ?? "";
                    break;
                case "NotFound":
                    badge.className = "badge bg-danger dynsec-badge";
                    badge.textContent = "No existe";
                    badge.title = "";
                    break;
                default:
                    badge.className = "badge bg-warning text-dark dynsec-badge";
                    badge.textContent = "Error";
                    badge.title = data.error ?? "";
            }
        }

        document.querySelectorAll(".btn-verify-dynsec").forEach(btn => {
            btn.addEventListener("click", async function () {
                const mac = this.dataset.mac;
                const badge = document.querySelector(`.dynsec-badge[data-mac="${CSS.escape(mac)}"]`);

                this.disabled = true;
                badge.className = "badge bg-secondary dynsec-badge";
                badge.textContent = "⏳";
                badge.title = "";

                try {
                    const res = await fetch(`/Devices/DynsecStatus?mac=${encodeURIComponent(mac)}`);
                    const data = await res.json();
                    await applyDynsecStatus(badge, data);
                } catch {
                    badge.className = "badge bg-danger dynsec-badge";
                    badge.textContent = "Error";
                    badge.title = "";
                }

                this.disabled = false;
            });
        });
    </script>
}
