@model IReadOnlyCollection<WebDispositivosMqtt.Controllers.DeviceAdminViewModel>

@{
    ViewData["Title"] = "Administración de dispositivos";
    var batteryTypes = ViewData["BatteryTypes"] as IReadOnlyList<WebDispositivosMqtt.Controllers.BatteryTypeOption>
                       ?? Array.Empty<WebDispositivosMqtt.Controllers.BatteryTypeOption>();
}

@functions {
    private static string? AsUtcIso(DateTime? value)
    {
        if (value is null) return null;
        var utc = value.Value.Kind switch
        {
            DateTimeKind.Utc   => value.Value,
            DateTimeKind.Local => value.Value.ToUniversalTime(),
            _                  => DateTime.SpecifyKind(value.Value, DateTimeKind.Utc)
        };
        return utc.ToString("O");
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Configuración</h2>
</div>

@if (TempData["Ok"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}
<div id="pageMsg" class="alert d-none"></div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>MAC</th>
            <th class="d-none d-md-table-cell">Habilitado</th>
            <th class="d-none d-lg-table-cell">Registrado por</th>
            <th class="d-none d-lg-table-cell">Fecha registro</th>
            <th>Password</th>
            <th class="d-none d-md-table-cell">DynSec</th>
            <th>Entregado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No hay dispositivos registrados.</td>
            </tr>
        }
        else
        {
            foreach (var d in Model)
            {
                <tr>
                    <td>@d.Name</td>
                    <td><code>@d.MacAddress</code></td>
                    <td class="d-none d-md-table-cell">@(d.IsEnabled ? "Sí" : "No")</td>
                    <td class="d-none d-lg-table-cell">@d.RegisteredByUserName</td>
                    <td class="d-none d-lg-table-cell" data-utc-datetime="@(AsUtcIso(d.RegisteredAtUtc) ?? "")"></td>
                    <td>
                        @if (d.HasPassword)
                        {
                            <span class="badge bg-success">ok</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">---</span>
                        }
                        <form method="post"
                              asp-controller="Devices"
                              asp-action="SetPassword"
                              class="d-inline ms-1"
                              onsubmit="return confirm('@(d.HasPassword ? $"¿Recrear password para {d.Name}? La contraseña actual quedará inválida." : $"¿Crear password para {d.Name}?")')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="deviceId" value="@d.DeviceId" />
                            <button type="submit" class="btn btn-sm @(d.HasPassword ? "btn-outline-warning" : "btn-outline-primary")">
                                @(d.HasPassword ? "Recrear" : "Crear")
                            </button>
                        </form>
                    </td>
                    <td class="d-none d-md-table-cell">
                        <span class="badge bg-secondary dynsec-badge" data-mac="@d.MacAddress">—</span>
                        <button class="btn btn-sm btn-outline-secondary btn-verify-dynsec ms-1"
                                data-mac="@d.MacAddress" title="Verificar DynSec">
                            <small>Verificar</small>
                        </button>
                    </td>
                    <td>
                        @if (d.IsDelivered)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                        @if (d.HasPassword)
                        {
                            <form method="post"
                                  asp-controller="Devices"
                                  asp-action="OpenWindow"
                                  class="d-inline ms-1"
                                  onsubmit="return confirm('¿Abrir ventana de provisioning para @d.Name?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="deviceId" value="@d.DeviceId" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    Abrir ventana
                                </button>
                            </form>
                        }
                    </td>
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary btn-open-config"
                                data-device-id="@d.DeviceId"
                                data-device-name="@d.Name"
                                title="Configuración">
                            ⚙<span class="d-none d-md-inline ms-1">Configuración</span>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@* Modal de configuración. Un ajuste nuevo es un <fieldset> más acá, con inputs
   cuyo name coincida con el campo que devuelve Devices/Config: el JS los llena solo. *@
<div class="modal fade" id="configModal" tabindex="-1" aria-labelledby="configModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="configModalLabel">Configuración · <span id="cfgDeviceName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="cfgError" class="alert alert-danger d-none"></div>

                <form id="cfgForm" novalidate>
                    <fieldset>
                        <legend class="fs-6 fw-semibold">Nivel del tanque</legend>
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="cfgFull" class="form-label small">Lleno (mm)</label>
                                <input id="cfgFull" name="fullDistanceMm" type="number" min="1" step="1" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label for="cfgEmpty" class="form-label small">Vacío (mm)</label>
                                <input id="cfgEmpty" name="emptyDistanceMm" type="number" min="1" step="1" class="form-control" />
                            </div>
                        </div>
                        <div class="form-text">Distancia del sensor a la superficie del líquido. Vacías: sin calibrar.</div>
                    </fieldset>

                    <fieldset class="mt-4">
                        <legend class="fs-6 fw-semibold">Batería</legend>
                        <select id="cfgBattery" name="batteryTypeId" class="form-select" aria-label="Tipo de batería">
                            <option value="">Por defecto (@(batteryTypes.FirstOrDefault(b => b.IsDefault)?.Name ?? "sin definir"))</option>
                            @foreach (var b in batteryTypes)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="cfgSave" class="btn btn-primary" disabled>Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        // ─── Modal de configuración ───────────────────────────────────────────
        const aft = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

        const configModal   = document.getElementById("configModal");
        const cfgDeviceName = document.getElementById("cfgDeviceName");
        const cfgError      = document.getElementById("cfgError");
        const cfgForm       = document.getElementById("cfgForm");
        const cfgSave       = document.getElementById("cfgSave");
        const pageMsg       = document.getElementById("pageMsg");

        let cfgDeviceId = null;

        function cfgShowError(msg) {
            cfgError.textContent = msg;
            cfgError.classList.toggle("d-none", !msg);
        }

        document.querySelectorAll(".btn-open-config").forEach(btn => {
            btn.addEventListener("click", async () => {
                cfgDeviceId = btn.dataset.deviceId;
                cfgDeviceName.textContent = btn.dataset.deviceName || cfgDeviceId;
                cfgForm.reset();
                cfgShowError("");
                cfgSave.disabled = true;
                bootstrap.Modal.getOrCreateInstance(configModal).show();

                try {
                    const res  = await fetch(`/Devices/Config?deviceId=${encodeURIComponent(cfgDeviceId)}`);
                    const data = await res.json();
                    if (!data.ok) { cfgShowError(data.error ?? "Error al cargar."); return; }

                    // Cada input se llena con el campo del mismo nombre
                    for (const el of cfgForm.elements)
                        if (el.name && el.name in data.config) el.value = data.config[el.name] ?? "";

                    cfgSave.disabled = false;
                } catch {
                    cfgShowError("Error de red.");
                }
            });
        });

        cfgSave.addEventListener("click", async () => {
            cfgShowError("");
            cfgSave.disabled = true;

            try {
                const fd = new FormData(cfgForm);
                fd.append("deviceId", cfgDeviceId);
                fd.append("__RequestVerificationToken", aft);

                const res  = await fetch("/Devices/SaveConfig", { method: "POST", body: fd });
                const data = await res.json();

                if (!data.ok) { cfgShowError(data.error ?? "Error al guardar."); return; }

                bootstrap.Modal.getOrCreateInstance(configModal).hide();
                pageMsg.textContent = data.message;
                pageMsg.className = "alert alert-success";
            } catch {
                cfgShowError("Error de red.");
            } finally {
                cfgSave.disabled = false;
            }
        });

        // Verificación DynSec por dispositivo
        async function applyDynsecStatus(badge, data) {
            switch (data.status) {
                case "Enabled":
                    badge.className = "badge bg-success dynsec-badge";
                    badge.textContent = "Habilitado";
                    badge.title = data.roles?.join(", ") ?? "";
                    break;
                case "Disabled":
                    badge.className = "badge bg-warning text-dark dynsec-badge";
                    badge.textContent = "Deshabilitado";
                    badge.title = data.roles?.join(", ") ?? "";
                    break;
                case "NotFound":
                    badge.className = "badge bg-danger dynsec-badge";
                    badge.textContent = "No existe";
                    badge.title = "";
                    break;
                default:
                    badge.className = "badge bg-warning text-dark dynsec-badge";
                    badge.textContent = "Error";
                    badge.title = data.error ?? "";
            }
        }

        document.querySelectorAll(".btn-verify-dynsec").forEach(btn => {
            btn.addEventListener("click", async function () {
                const mac = this.dataset.mac;
                const badge = document.querySelector(`.dynsec-badge[data-mac="${CSS.escape(mac)}"]`);

                this.disabled = true;
                badge.className = "badge bg-secondary dynsec-badge";
                badge.textContent = "⏳";
                badge.title = "";

                try {
                    const res = await fetch(`/Devices/DynsecStatus?mac=${encodeURIComponent(mac)}`);
                    const data = await res.json();
                    await applyDynsecStatus(badge, data);
                } catch {
                    badge.className = "badge bg-danger dynsec-badge";
                    badge.textContent = "Error";
                    badge.title = "";
                }

                this.disabled = false;
            });
        });
    </script>
}
