@model IReadOnlyList<WebDispositivosMqtt.Controllers.DeviceConnectionViewModel>
@{
    ViewData["Title"] = "Dispositivos";
    var isAdmin = User.IsInRole("Admin");
    var cmdTimeout = (int)(ViewData["CommandTimeoutSeconds"] ?? 15);
}

@functions {
    private static string? AsUtcIso(DateTime value)
    {
        if (value == default) return null;
        var utc = value.Kind switch
        {
            DateTimeKind.Utc   => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _                  => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
        return utc.ToString("O");
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Conexiones</h2>
</div>

<div id="hubBanner" class="alert alert-warning py-2 px-3 mb-0 rounded-0 d-none"
     style="position:sticky; top:0; z-index:1030;" role="alert">
    <span id="hubBannerMsg"></span>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            @if (isAdmin)
            {
                <th class="d-none d-lg-table-cell">MAC</th>
            }
            <th>Estado</th>
            <th class="d-none d-sm-table-cell">Última actividad</th>
            <th>Terminal</th>
            @if (isAdmin)
            {
                <th class="d-none d-xl-table-cell">Tipo señal</th>
                <th class="d-none d-xl-table-cell">Habilitado</th>
                <th class="d-none d-xl-table-cell">Registrado por</th>
                <th class="d-none d-xl-table-cell">Fecha registro</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="@(isAdmin ? 9 : 4)" class="text-center text-muted">No hay dispositivos para mostrar.</td>
            </tr>
        }
        else
        {
            foreach (var d in Model)
            {
                var deviceKey = d.MacAddress ?? string.Empty;
                <tr data-device-key="@deviceKey">
                    <td>@(string.IsNullOrWhiteSpace(d.Name) ? "-" : d.Name)</td>

                    @if (isAdmin)
                    {
                        <td class="d-none d-lg-table-cell">@(string.IsNullOrWhiteSpace(d.MacAddress) ? "-" : d.MacAddress)</td>
                    }

                    <td class="device-status-cell">
                        @if (d.IsOnline)
                        {
                            <span class="device-online"><span class="status-dot online"></span>Conectado</span>
                        }
                        else
                        {
                            <span class="device-offline"><span class="status-dot offline"></span>Sin conexión</span>
                        }
                    </td>
                    <td class="device-lastseen-cell d-none d-sm-table-cell" data-utc-datetime="@(AsUtcIso(d.LastSeenUtc) ?? "")"></td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary btn-open-terminal"
                                data-device-id="@d.DeviceId"
                                data-device-name="@d.Name">
                            &gt;_
                        </button>
                    </td>
                    @if (isAdmin)
                    {
                        <td class="device-signaltype-cell d-none d-xl-table-cell">@(d.LastSeenType?.ToString() ?? "-")</td>
                        <td class="d-none d-xl-table-cell">@(d.IsEnabled ? "Sí" : "No")</td>
                        <td class="d-none d-xl-table-cell">@(string.IsNullOrWhiteSpace(d.RegisteredByUserName) ? "-" : d.RegisteredByUserName)</td>
                        <td class="d-none d-xl-table-cell" data-utc-datetime="@(AsUtcIso(d.RegisteredAtUtc) ?? "")"></td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
</div>

@* Modal terminal *@
<div class="modal fade" id="terminalModal" tabindex="-1" aria-labelledby="terminalModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="background-color:#1e1e1e; color:#e5e7eb; border-color:#444;">
            <div class="modal-header" style="border-color:#444;">
                <h6 class="modal-title font-monospace" id="terminalModalLabel" style="color:#4ade80;">
                    &gt;_ <span id="termDeviceName"></span>
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0" style="background-color:#1e1e1e;">
                <div id="termOutput"
                     style="height:360px; overflow-y:auto; padding:0.75rem 1rem; font-family:'Courier New',Courier,monospace; font-size:0.85rem; background-color:#1e1e1e; line-height:1.5;">
                </div>
            </div>
            <div class="modal-footer flex-column align-items-start p-2" style="background-color:#252526; border-color:#444;">
                <div class="input-group w-100">
                    <span class="input-group-text font-monospace"
                          style="background-color:#252526; color:#4ade80; border-color:#555;">$</span>
                    <input id="termInput" type="text"
                           class="form-control font-monospace"
                           style="background-color:#1e1e1e; color:#e5e7eb; border-color:#555; caret-color:#4ade80;"
                           placeholder="Escribe un comando…" autocomplete="off" spellcheck="false" />
                    <button id="termSendBtn" class="btn btn-outline-success" type="button">Enviar</button>
                </div>
                <small style="color:#6b7280; font-size:0.72rem; margin-top:4px;">
                    Enter para enviar &nbsp;·&nbsp; ↑↓ historial
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // ─── Antiforgery token ────────────────────────────────────────────────
        const aft = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? "";

        // ─── Tabla: estado de dispositivos ───────────────────────────────────
        const hubBanner    = document.getElementById("hubBanner");
        const hubBannerMsg = document.getElementById("hubBannerMsg");

        function showBanner(msg, type) {
            hubBannerMsg.textContent = msg;
            hubBanner.className = `alert py-2 px-3 mb-0 rounded-0 alert-${type}`;
        }
        function hideBanner() {
            hubBanner.classList.add("d-none");
        }
        const rowsByDeviceKey = new Map();
        const statusByKey     = new Map();

        document.querySelectorAll("tr[data-device-key]").forEach(row => {
            const key = row.getAttribute("data-device-key");
            if (key) rowsByDeviceKey.set(key, row);
        });

        function formatSignalType(state) {
            if (state.expired) return "Expirado (inactividad)";
            if (!state.lastSeenType) return "-";
            switch (state.lastSeenType) {
                case "Status":    return state.isOnline ? "Status / Online" : "Status / Offline";
                case "Heartbeat": return "Heartbeat";
                case "Telemetry": return "Telemetría";
                default:          return state.lastSeenType;
            }
        }

        function renderRow(key) {
            const row   = rowsByDeviceKey.get(key);
            const state = statusByKey.get(key);
            if (!row || !state) return;

            const statusCell = row.querySelector(".device-status-cell");
            if (statusCell)
                statusCell.innerHTML = state.isOnline
                    ? '<span class="device-online"><span class="status-dot online"></span>Conectado</span>'
                    : '<span class="device-offline"><span class="status-dot offline"></span>Sin conexión</span>';

            const lastSeenCell = row.querySelector(".device-lastseen-cell");
            if (lastSeenCell && state.lastSeenUtc) {
                lastSeenCell.dataset.utcDatetime = state.lastSeenUtc;
                lastSeenCell.textContent = window.appFormatUtcDateTime?.(state.lastSeenUtc) ?? state.lastSeenUtc;
            }

            const signalTypeCell = row.querySelector(".device-signaltype-cell");
            if (signalTypeCell) signalTypeCell.textContent = formatSignalType(state);
        }

        // ─── Terminal ─────────────────────────────────────────────────────────
        const cmdTimeoutSeconds = @cmdTimeout;

        const terminalModal  = document.getElementById("terminalModal");
        const termOutput     = document.getElementById("termOutput");
        const termInput      = document.getElementById("termInput");
        const termSendBtn    = document.getElementById("termSendBtn");
        const termDeviceName = document.getElementById("termDeviceName");

        let termDeviceId = null;
        let termCmdId    = null;
        let termLocked   = false;
        let termTimer    = null;
        let termHistory  = [];
        let termHistIdx  = -1;

        document.querySelectorAll(".btn-open-terminal").forEach(btn => {
            btn.addEventListener("click", () => {
                termDeviceId = btn.dataset.deviceId;
                termDeviceName.textContent = btn.dataset.deviceName || btn.dataset.deviceId;
                termOutput.innerHTML = "";
                termCmdId   = null;
                termHistIdx = -1;
                clearTimeout(termTimer);
                termUnlock();
                termAppend("system", "Terminal lista. Escribe 'ayuda' para ver los comandos disponibles.");
                bootstrap.Modal.getOrCreateInstance(terminalModal).show();
            });
        });

        terminalModal.addEventListener("shown.bs.modal", () => {
            termInput.focus();
        });

        terminalModal.addEventListener("hidden.bs.modal", () => {
            clearTimeout(termTimer);
            termCmdId  = null;
            termLocked = false;
        });

        termSendBtn.addEventListener("click", termSend);
        termInput.addEventListener("keydown", e => {
            if (e.key === "Enter") { termSend(); return; }
            if (e.key === "ArrowUp") {
                e.preventDefault();
                if (termHistIdx < termHistory.length - 1)
                    termInput.value = termHistory[++termHistIdx];
                return;
            }
            if (e.key === "ArrowDown") {
                e.preventDefault();
                if (termHistIdx > 0)      termInput.value = termHistory[--termHistIdx];
                else { termHistIdx = -1;  termInput.value = ""; }
            }
        });

        async function termSend() {
            const cmd = termInput.value.trim();
            if (!cmd || termLocked) return;

            if (termHistory[0] !== cmd) termHistory.unshift(cmd);
            if (termHistory.length > 50) termHistory.length = 50;
            termHistIdx     = -1;
            termInput.value = "";

            termAppend("cmd", cmd);
            termLock();

            try {
                const fd = new FormData();
                fd.append("deviceId", termDeviceId);
                fd.append("cmd", cmd);
                fd.append("__RequestVerificationToken", aft);

                const res  = await fetch("/Devices/SendCommand", { method: "POST", body: fd });
                const data = await res.json();

                if (!data.ok) {
                    termAppend("error", data.error ?? "Error al enviar");
                    termUnlock();
                    return;
                }

                termCmdId = data.commandId;
                termTimer = setTimeout(() => {
                    termAppend("timeout", `Sin respuesta (${cmdTimeoutSeconds}s)`);
                    termCmdId = null;
                    termUnlock();
                }, cmdTimeoutSeconds * 1000);

            } catch {
                termAppend("error", "Error de red");
                termUnlock();
            }
        }

        function termLock()   { termLocked = true;  termInput.disabled = true;  termSendBtn.disabled = true;  }
        function termUnlock() { termLocked = false; termInput.disabled = false; termSendBtn.disabled = false; termInput.focus(); }

        function termAppend(type, text) {
            const colors   = { cmd: "#4ade80", error: "#f87171", timeout: "#fbbf24", system: "#6b7280" };
            const prefixes = { cmd: "$ ",      error: "✗ ", timeout: "⏱ ", system: "» " };
            const color    = colors[type]   ?? "#e5e7eb";
            const prefix   = prefixes[type] ?? "";

            const lines = text.replace(/\r/g, "").split("\n");
            if (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();

            lines.forEach((line, i) => {
                const div = document.createElement("div");
                div.style.color      = color;
                div.style.whiteSpace = "pre-wrap";
                div.style.wordBreak  = "break-word";
                div.textContent = (i === 0 ? prefix : " ".repeat(prefix.length)) + line;
                termOutput.appendChild(div);
            });

            termOutput.scrollTop = termOutput.scrollHeight;
        }

        // ─── SignalR ──────────────────────────────────────────────────────────
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/Hubs/DeviceConnectionsHub")
            .withAutomaticReconnect()
            .build();

        connection.on("EstadoInicial", devices => {
            if (!Array.isArray(devices)) return;
            for (const d of devices) {
                if (!d.macAddress || !rowsByDeviceKey.has(d.macAddress)) continue;
                statusByKey.set(d.macAddress, {
                    isOnline: !!d.isOnline,
                    lastSeenUtc: d.lastSeenUtc ?? null,
                    lastSeenType: d.lastSeenType ?? null,
                    expired: false
                });
                renderRow(d.macAddress);
            }
        });

        connection.on("EstadoDispositivoCambiado", payload => {
            const mac = payload?.macAddress;
            if (!mac || !rowsByDeviceKey.has(mac)) return;
            statusByKey.set(mac, {
                isOnline: payload?.isOnline ?? false,
                lastSeenUtc: payload?.changedAtUtc ?? null,
                lastSeenType: payload?.lastSeenType ?? null,
                expired: false
            });
            renderRow(mac);
        });

        connection.on("DispositivoExpirado", payload => {
            const mac = payload?.macAddress;
            if (!mac || !rowsByDeviceKey.has(mac)) return;
            statusByKey.set(mac, {
                isOnline: false,
                lastSeenUtc: statusByKey.get(mac)?.lastSeenUtc ?? null,
                lastSeenType: null,
                expired: true
            });
            renderRow(mac);
        });

        connection.on("ComandoAcknowledged", payload => {
            if (!termCmdId || payload?.commandId !== termCmdId) return;
            clearTimeout(termTimer);
            termCmdId = null;

            if (payload.response) {
                const isErr = payload.ackStatus === "error";
                termAppend(isErr ? "error" : "response", payload.response);
            }
            termUnlock();
        });

        connection.onreconnecting(() => {
            showBanner("Sin conexión en tiempo real — reconectando…", "warning");
        });
        connection.onreconnected(() => {
            hideBanner();
        });
        connection.onclose(() => {
            showBanner("Sin conexión en tiempo real — recarga la página si los estados no se actualizan.", "danger");
        });

        (async () => {
            try {
                await connection.start();
                hideBanner();
            } catch {
                showBanner("No se pudo establecer la conexión en tiempo real — recarga la página.", "danger");
            }
        })();
    </script>
}
