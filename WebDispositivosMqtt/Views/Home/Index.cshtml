@{
    ViewData["Title"] = "Prueba SignalR + MQTT";
}

<div class="row">
    <div class="col-md-10">
        <h1 class="display-6">Prueba SignalR + lectura MQTT real</h1>
        <p class="text-muted">
            Esta página recibe mensajes del broker MQTT a través del servidor y los muestra en tiempo real.
        </p>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="usuario" class="form-label">Usuario</label>
                <input id="usuario" class="form-control" value="Usuario web" />
            </div>
            <div class="col-md-6">
                <label class="form-label">ConnectionId</label>
                <input id="connectionId" class="form-control" readonly />
            </div>
        </div>

        <div class="mb-3">
            <label for="mensaje" class="form-label">Mensaje de prueba SignalR</label>
            <input id="mensaje" class="form-control" placeholder="Escribe un mensaje" />
        </div>

        <div class="mb-3 d-flex gap-2">
            <button id="btnConectar" class="btn btn-secondary">Conectar</button>
            <button id="btnEnviar" class="btn btn-primary" disabled>Enviar a todos</button>
        </div>

        <div class="mb-3 d-flex gap-4">
            <div>
                <strong>Estado:</strong>
                <span id="estado" class="badge bg-warning text-dark">Desconectado</span>
            </div>
            <div>
                <strong>Total conectados:</strong>
                <span id="totalConectados" class="badge bg-info text-dark">0</span>
            </div>
        </div>

        <hr />

        <h2 class="h4">Mensajes del sistema</h2>
        <ul id="mensajesSistema" class="list-group mb-4"></ul>

        <h2 class="h4">Mensajes SignalR</h2>
        <ul id="mensajes" class="list-group mb-4"></ul>

        <h2 class="h4">Mensajes MQTT recibidos</h2>
        <ul id="mensajesMqtt" class="list-group"></ul>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const estado = document.getElementById("estado");
        const totalConectados = document.getElementById("totalConectados");
        const connectionId = document.getElementById("connectionId");
        const btnConectar = document.getElementById("btnConectar");
        const btnEnviar = document.getElementById("btnEnviar");
        const inputUsuario = document.getElementById("usuario");
        const inputMensaje = document.getElementById("mensaje");
        const listaMensajes = document.getElementById("mensajes");
        const listaMensajesSistema = document.getElementById("mensajesSistema");
        const listaMensajesMqtt = document.getElementById("mensajesMqtt");

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/Hubs/EchoHub")
            .withAutomaticReconnect()
            .build();

        function agregarMensajeSistema(texto) {
            const item = document.createElement("li");
            item.className = "list-group-item list-group-item-light";
            item.textContent = texto;
            listaMensajesSistema.prepend(item);
        }

        connection.on("ConexionEstablecida", (id, total) => {
            connectionId.value = id;
            totalConectados.textContent = total;
            agregarMensajeSistema(`Conectado al hub con id ${id}`);
        });

        connection.on("ActualizarTotalConexiones", (total) => {
            totalConectados.textContent = total;
        });

        connection.on("MensajeSistema", (texto) => {
            agregarMensajeSistema(texto);
        });

        connection.on("RecibirMensaje", (usuario, mensaje, fecha, total) => {
            const item = document.createElement("li");
            item.className = "list-group-item";
            item.textContent = `[${fecha}] ${usuario}: ${mensaje}`;
            listaMensajes.prepend(item);

            if (typeof total !== "undefined") {
                totalConectados.textContent = total;
            }
        });

        connection.on("RecibirMensajeMqtt", (topic, payload, fecha) => {
            const item = document.createElement("li");
            item.className = "list-group-item";
            item.textContent = `[${fecha}] ${topic} => ${payload}`;
            listaMensajesMqtt.prepend(item);
        });

        connection.onreconnecting(() => {
            estado.textContent = "Reconectando";
            estado.className = "badge bg-warning text-dark";
            btnEnviar.disabled = true;
        });

        connection.onreconnected(() => {
            estado.textContent = "Conectado";
            estado.className = "badge bg-success";
            btnEnviar.disabled = false;
            agregarMensajeSistema("Reconexión completada");
        });

        connection.onclose(() => {
            estado.textContent = "Desconectado";
            estado.className = "badge bg-danger";
            btnEnviar.disabled = true;
            connectionId.value = "";
            btnConectar.disabled = false;
        });

        btnConectar.addEventListener("click", async () => {
            try {
                await connection.start();
                estado.textContent = "Conectado";
                estado.className = "badge bg-success";
                btnEnviar.disabled = false;
                btnConectar.disabled = true;
            } catch {
                estado.textContent = "Error al conectar";
                estado.className = "badge bg-danger";
            }
        });

        btnEnviar.addEventListener("click", async () => {
            const usuario = inputUsuario.value.trim();
            const mensaje = inputMensaje.value.trim();

            if (!usuario || !mensaje) {
                return;
            }

            await connection.invoke("EnviarMensaje", usuario, mensaje);
            inputMensaje.value = "";
            inputMensaje.focus();
        });

        inputMensaje.addEventListener("keydown", (event) => {
            if (event.key === "Enter" && !btnEnviar.disabled) {
                event.preventDefault();
                btnEnviar.click();
            }
        });
    </script>
}