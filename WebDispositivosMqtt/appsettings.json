{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provisioning": {
    "EncryptionKey": "REPLACE_WITH_SECRET",
    "ExpirationMinutes": 1
  },
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_SECRET"
  },
  "DeviceRequests": {
    "ActiveTtlSeconds": 300,
    "HistoryTtlSeconds": 600,
    "CleanupIntervalSeconds": 30
  },
  "Terminal": {
    "CommandTimeoutSeconds": 20
  },
  "DeviceConnectionCleanup": {
    "AntiguedadSeconds": 90,
    "PeriodoSeconds": 30
  },
  "Mqtt": {
    "Host": "REPLACE_WITH_SECRET",
    "Port": 1883,
    "UseTls": false,
    "KeepAliveSeconds": 30,
    "Listener": {
      "ClientId": "app-lis-dev",
      "Username": "app-rw",
      "Password": "REPLACE_WITH_SECRET"
    },
    "Publisher": {
      "ClientId": "app-pub-dev",
      "Username": "app-rw",
      "Password": "REPLACE_WITH_SECRET"
    },
    "Dynsec": {
      "ClientId": "app-reg-dev",
      "Username": "app-reg",
      "Password": "REPLACE_WITH_SECRET"
    },
    "SubscribeTopics": [
      "devices/#"
    ],
    "PublishTopicTemplates": {
      "Commands": "devices/{deviceId}/commands",
      "Config": "devices/{deviceId}/config"
    }
  }
}